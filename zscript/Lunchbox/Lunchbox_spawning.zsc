//============================================
// Spawning
//============================================
class WildLCHBX : IdleDummy {
	override void postbeginplay() {
		super.postbeginplay();
		let SpawnedLCHBX=VirLunchbox(spawn("VirLunchbox",pos,ALLOW_REPLACE));
		SpawnedLCHBX.vel = vel;
		SpawnedLCHBX.RandomContents();
		self.destroy();
	}
}
